# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=blackbox_user
DB_PASSWORD=blackbox_password_placeholder
DB_NAME=am_blackbox

# Grafana Configuration
GRAFANA_URL=https://your-org.grafana.net
GRAFANA_API_TOKEN=glc_placeholder_token
GRAFANA_METRICS_DATASOURCE_UID=prometheus-uid
GRAFANA_LOGS_DATASOURCE_UID=loki-uid

# Kubernetes Configuration
KUBECONFIG_PATH=/path/to/kubeconfig
# or for in-cluster:
KUBERNETES_IN_CLUSTER=false

# Zoho Cliq Configuration
ZOHO_CLIQ_WEBHOOK_URL=https://cliq.zoho.com/api/v2/channelsbyname/alerts/message?zapikey=placeholder
ZOHO_CLIQ_BOT_TOKEN=placeholder_token

# Environment / Provider Configuration
ORACLE_CLOUD_REGION=ap-mumbai-1
ORACLE_CLOUD_TENANCY=ocid1.tenancy.oc1..placeholder
ORACLE_CLOUD_USER=ocid1.user.oc1..placeholder
ORACLE_CLOUD_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
ORACLE_CLOUD_KEY_FILE=/path/to/private.pem

# Security / Authentication
MCP_API_KEY=mcp_secret_placeholder
ACTION_TOKEN_SECRET=jwt_secret_placeholder
